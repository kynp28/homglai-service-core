generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================
// 1. Users & Roles
// ==============================

model Employee {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  name         String
  role         EmployeeRole   @default(TECHNICIAN)
  status       EmployeeStatus @default(AVAILABLE)
  isActive     Boolean        @default(true)
  lineUserId   String?        @unique
  // Moment the technician last became AVAILABLE. Used for FIFO queue ordering
  // (longest-idle first) instead of updatedAt, which changes on every row update.
  availableSince DateTime?
  // Fixed weekly day off, 0 = Sunday ... 6 = Saturday (Asia/Bangkok). Business-minute timers of the
  // technician's own jobs are paused on that day. null = no fixed day off.
  weeklyDayOff Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignedOrders RepairOrder[]      @relation("AssignedTechnician")
  statusLogs     StatusLog[]
  resolvedItems  RepairItem[]       @relation("ItemResolvedBy")
  uploadedImages RepairOrderImage[]
  notifications  Notification[]
  helpedOrders   RepairOrderHelper[] @relation("HelperTechnician")
  helpersAdded   RepairOrderHelper[] @relation("HelperAddedBy")
  holidaysCreated ShopHoliday[]     @relation("HolidayCreatedBy")
  paymentsRecorded RepairOrder[]    @relation("PaymentRecordedBy")
}

model Customer {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String   @unique
  address    String?  @db.Text
  // LINE accounts are linked per repair order (OrderLineSubscription) since Phase 6
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  machines     Machine[]
  repairOrders RepairOrder[]
}

// ==============================
// 2. Master Data (Templates)
// ==============================

model SymptomCategory {
  id       Int       @id @default(autoincrement())
  name     String
  symptoms Symptom[]
}

model Symptom {
  id         Int             @id @default(autoincrement())
  name       String
  categoryId Int
  category   SymptomCategory @relation(fields: [categoryId], references: [id])

  repairOrders RepairOrderSymptom[]
}

// ==============================
// 3. Core Business (Repairs)
// ==============================

model Machine {
  id           Int      @id @default(autoincrement())
  brand        String
  model        String
  serialNumber String?
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repairOrders RepairOrder[]
}

model RepairOrder {
  id            Int          @id @default(autoincrement())
  jobNumber     String       @unique
  trackingToken String       @unique
  status        RepairStatus @default(NEW)

  // Relations
  customerId   Int
  customer     Customer     @relation(fields: [customerId], references: [id])
  machineId    Int
  machine      Machine      @relation(fields: [machineId], references: [id])

  // Queue & Assignment
  technicianId Int?
  technician   Employee?    @relation("AssignedTechnician", fields: [technicianId], references: [id])

  // Details
  otherSymptom String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Paper form (SRS 2)
  paperBookNo        String?          @db.VarChar(20)
  paperReceiptNo     String?          @unique @db.VarChar(20)
  receivedDate       DateTime         @db.Date
  workType           WorkType         @default(REPAIR)
  warrantyStatus     WarrantyStatus?
  warrantyExpiryDate DateTime?        @db.Date
  billingType        BillingType?
  loanerMachine      Boolean          @default(false)
  loanerNote         String?          @db.VarChar(500)
  accessories        Json?
  careAdvice         Json?
  warningNote        String?          @db.Text

  // Assignment / acknowledgement (SRS 3.3)
  assignedAt        DateTime?
  acknowledgedAt    DateTime?
  lastAckReminderAt DateTime?
  ackReminderCount  Int       @default(0)
  // Higher value is picked first. Used to push orders returned from a deactivated
  // technician to the head of the queue. Legacy orders = 0.
  queuePriority     Int       @default(0)

  // Progress reminders (SRS 3.6)
  lastActivityAt         DateTime?
  lastProgressReminderAt DateTime?
  progressReminderCount  Int       @default(0)

  // Closing
  closedAt          DateTime?
  completionSummary String?   @db.Text
  // REPAIRED or NOT_REPAIRED (customer declined); legacy COMPLETED/DELIVERED orders backfilled REPAIRED
  repairOutcome     RepairOutcome?

  // Payment recorded at / after delivery (record only, never blocks delivery)
  paidAmount          Decimal?       @db.Decimal(10, 2)
  paymentMethod       PaymentMethod?
  paymentNote         String?        @db.VarChar(500)
  paidAt              DateTime?
  paymentRecordedById Int?
  paymentRecordedBy   Employee?      @relation("PaymentRecordedBy", fields: [paymentRecordedById], references: [id])

  symptoms    RepairOrderSymptom[]
  repairItems RepairItem[]
  statusLogs  StatusLog[]
  images      RepairOrderImage[]
  lineSubscriptions OrderLineSubscription[]
  helpers     RepairOrderHelper[]

  @@index([status, technicianId])
  @@index([status, acknowledgedAt])
  @@index([closedAt])
  @@index([lastActivityAt])
  @@index([status, technicianId, queuePriority, createdAt])
  @@index([paymentRecordedById])
}

// Mapping Table สำหรับอาการเสีย (Many-to-Many)
model RepairOrderSymptom {
  repairOrderId Int
  symptomId     Int

  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  symptom       Symptom     @relation(fields: [symptomId], references: [id])

  @@id([repairOrderId, symptomId])
}

// ==============================
// 4. Itemized Approvals (วงจรเสนอราคา)
// ==============================

model RepairItem {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])

  barcode       String?     @db.VarChar(64)
  name          String
  quantity      Int         @default(1)
  // Maps to the legacy `price` column so existing data stays valid without moving it.
  unitPrice     Decimal     @map("price") @db.Decimal(10, 2)
  itemType      ItemType    @default(PART)
  status        ItemStatus  @default(PENDING)

  // Resolution (price confirmation) audit trail
  resolvedById      Int?
  resolvedBy        Employee?          @relation("ItemResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  resolutionChannel ResolutionChannel?
  resolutionNote    String?            @db.VarChar(500)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==============================
// 4.1 Images, LINE subscriptions, in-app notifications
// ==============================

model RepairOrderImage {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  kind          ImageKind
  // Relative path only (never exposed through any API response)
  storagePath   String      @db.VarChar(255)
  uploadedById  Int
  uploadedBy    Employee    @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([repairOrderId, kind])
}

/// Technicians who helped on a job (informational only; never affects the queue).
/// The job owner picks them when completing; ADMIN/RECEPTIONIST can edit until DELIVERED/CANCELLED.
model RepairOrderHelper {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  technicianId  Int
  technician    Employee    @relation("HelperTechnician", fields: [technicianId], references: [id])
  addedById     Int
  addedBy       Employee    @relation("HelperAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([repairOrderId, technicianId])
  @@index([technicianId])
  @@index([addedById])
}

model OrderLineSubscription {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  lineUserId    String
  createdAt     DateTime    @default(now())

  @@unique([repairOrderId, lineUserId])
  @@index([lineUserId])
}

model Notification {
  id            Int       @id @default(autoincrement())
  recipientId   Int
  recipient     Employee  @relation(fields: [recipientId], references: [id])
  type          String    @db.VarChar(40)
  repairOrderId Int?
  title         String
  body          String    @db.Text
  payload       Json?
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  @@index([recipientId, readAt, createdAt])
}

// ==============================
// 5. Tracking & Logs
// ==============================

model StatusLog {
  id            Int          @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id])

  status        RepairStatus
  changedById   Int?
  changedBy     Employee?    @relation(fields: [changedById], references: [id])
  note          String?      @db.Text

  createdAt     DateTime     @default(now())
}

// ==============================
// Enums
// ==============================

enum EmployeeRole {
  ADMIN
  TECHNICIAN
  RECEPTIONIST
}

enum EmployeeStatus {
  AVAILABLE
  BUSY
  OFFLINE
  RESERVED
}

// Only REPAIR for now; ONSITE_REPAIR can be added later with an enum-extending migration.
enum WorkType {
  REPAIR
}

enum WarrantyStatus {
  IN_WARRANTY
  OUT_OF_WARRANTY
}

enum BillingType {
  CHARGE_OUT_OF_WARRANTY
  NO_CHARGE_IN_WARRANTY
  CHARGE_IN_WARRANTY
}

enum ItemType {
  PART
  TRAVEL_FEE
  LABOR_HOURS
  SERVICE_FEE
}

enum ResolutionChannel {
  PHONE
  LINE
}

enum ImageKind {
  INTAKE
  RECEIPT_PAPER
  DELIVERY
  OTHER
}

enum RepairStatus {
  NEW
  INSPECTING
  WAITING_APPROVAL
  REPAIRING
  COMPLETED
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Phase 5b: one row per job-number prefix (REP-YYMM). lastSeq is incremented atomically inside the
// intake transaction so concurrent intakes never collide on jobNumber.
model JobNumberSequence {
  prefix    String   @id @db.VarChar(16)
  lastSeq   Int
  updatedAt DateTime @updatedAt
}

// Phase 5b: special shop closures (e.g. Songkran). Business-minute timers skip these dates.
model ShopHoliday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  name        String   @db.VarChar(100)
  createdById Int
  createdBy   Employee @relation("HolidayCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdById])
}

enum RepairOutcome {
  REPAIRED
  NOT_REPAIRED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}
