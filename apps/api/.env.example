PORT=4000
DATABASE_URL="mysql://username:password@localhost:3306/homglai_db"
JWT_SECRET="your-at-least-32-character-jwt-secret-key-here"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
PUBLIC_TRACKING_BASE_URL="https://example.com/tracking/"
TRUST_PROXY="false"
ALLOW_DESTRUCTIVE_TESTS="false"
MYSQL_ROOT_PASSWORD="your-secure-mysql-root-password"
SEED_DEFAULT_PASSWORD="required-for-seed-test-script"

# ---------------------------------------------------------------------------
# การตั้งค่าระบบงาน (Phase 3) — ไม่ใส่ก็ได้ จะใช้ค่าเริ่มต้นด้านล่าง
# ค่าผิดรูปแบบ server จะไม่ยอมสตาร์ทและบอกว่าตัวแปรไหนผิด
# ---------------------------------------------------------------------------
# เวลา (นาที) ที่ช่างไม่กดรับงานแล้วจะเริ่มเตือน ADMIN
ACK_TIMEOUT_MINUTES=60
# เตือน ADMIN ซ้ำทุกกี่นาที ถ้าช่างยังไม่กดรับงาน
ACK_REMINDER_INTERVAL_MINUTES=60
# ใบงานไม่มีความเคลื่อนไหวกี่นาที (นับเฉพาะเวลาทำการ) จึงถามช่างว่ายังซ่อมอยู่ไหม
PROGRESS_REMINDER_INTERVAL_MINUTES=60
# ช่างไม่ตอบคำถามความคืบหน้าครบกี่รอบ จึงแจ้ง ADMIN
PROGRESS_UNANSWERED_ADMIN_THRESHOLD=3
# เวลาทำการของร้าน (เวลาไทย, HH:MM) ใช้ทุกวัน ยกเว้นวันหยุดร้าน (/api/holidays) และวันหยุดประจำสัปดาห์ของช่าง
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:30
# ลบรูปถ่ายอัตโนมัติหลังใบงานปิด (ส่งมอบ/ยกเลิก) กี่วัน
IMAGE_RETENTION_DAYS=30
# งานเบื้องหลังตรวจทุกกี่วินาที และเปิด/ปิดงานเบื้องหลัง (true/false)
JOB_WORKER_INTERVAL_SECONDS=60
JOBS_ENABLED=true
# เปิดให้ลูกค้ากดอนุมัติราคาผ่าน LINE (เฟส 1 ปิดไว้ ร้านยืนยันทางโทรศัพท์)
CUSTOMER_LINE_APPROVAL_ENABLED=false
# ยอดรวมใบงาน (บาท, ทุกประเภทรายการ ไม่นับที่ลูกค้าไม่อนุมัติ) ที่ต้องโทรยืนยันราคากับลูกค้า
# ต่ำกว่านี้ระบบอนุมัติรายการให้อัตโนมัติ ; 0 = ทุกรายการต้องยืนยัน (ค่าเริ่มต้น)
PRICE_APPROVAL_THRESHOLD=1000
# จำนวนครั้งค้นหาสาธารณะสูงสุดต่อ IP ต่อ 15 นาที
PUBLIC_SEARCH_RATE_LIMIT_MAX=30
# ที่เก็บรูป และขนาด/จำนวน/ความกว้างด้านยาวสูงสุดของรูป
IMAGE_STORAGE_DIR=./data/uploads
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PER_KIND=10
IMAGE_MAX_LONG_EDGE=1600
# ช่องทางแจ้งเตือนพนักงาน (ตอนนี้มีแค่ db = แสดงในเว็บ; LINE ภายหลัง)
NOTIFIER_DRIVER=db
# LINE Login channel ID ของ LIFF ที่ลูกค้าใช้ผูกบัญชีกับใบงาน (POST /api/tracking/subscribe-line)
LINE_LOGIN_CHANNEL_ID="your-line-login-channel-id"
# ตัวตรวจ LINE access token: line (ค่าเริ่มต้น) ; mock ใช้ได้เฉพาะ NODE_ENV=test เท่านั้น
LINE_IDENTITY_VERIFIER=line
# เปิดหน้า Swagger (/api-docs) แม้ NODE_ENV=production — ใช้กับเซิร์ฟเวอร์เดโมเท่านั้น
# SWAGGER_ENABLED=true
